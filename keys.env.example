# Copy this file to keys.env (same folder) and paste your keys after the = signs.
# keys.env is read by every run, including the Monday scheduled task.
# Keep it private:  chmod 600 keys.env

# LinkedIn search via Tavily (free: 1,000 searches/month, no card): https://app.tavily.com
TAVILY_API_KEY=

# Or LinkedIn search via Brave Search API (official API): https://brave.com/search/api/
BRAVE_API_KEY=

# Or LinkedIn search via SerpAPI (Google results): https://serpapi.com/
SERPAPI_KEY=

# Optional: AI-written competitor briefs and trend summaries (--summarize)
ANTHROPIC_API_KEY=
